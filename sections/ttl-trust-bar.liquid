<section class="trust-bar section--compact ttl-pattern-blockprint">
  <div class="page-width trust-bar__grid">
    {%- for block in section.blocks -%}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="trust-bar__icon">
          {% render 'ttl-icon', icon: block.settings.icon %}
        </span>
        <span class="trust-bar__copy">
          <strong>{{ block.settings.title }}</strong>
          {%- if block.settings.text != blank -%}
            <small>{{ block.settings.text }}</small>
          {%- endif -%}
        </span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "dress", "label": "Curated" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "quality", "label": "Quality" },
            { "value": "bag", "label": "Shopping" }
          ],
          "default": "dress"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Curated Styles" },
        { "type": "text", "id": "text", "label": "Text", "default": "Handpicked with love" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "dress", "title": "Curated Styles", "text": "Handpicked with love" } },
        { "type": "trust_item", "settings": { "icon": "leaf", "title": "Sustainable Fashion", "text": "Good for you, better for the planet" } },
        { "type": "trust_item", "settings": { "icon": "quality", "title": "Quality Pieces", "text": "Like new, always" } },
        { "type": "trust_item", "settings": { "icon": "bag", "title": "Easy Shopping", "text": "Simple, secure, seamless" } }
      ]
    }
  ]
}
{% endschema %}
