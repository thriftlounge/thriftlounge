<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{{ 'templates.search.title' | t }}</p>
        <h1>
          {%- if search.performed -%}
            {{ 'templates.search.results_with_count' | t: count: search.results_count, terms: search.terms }}
          {%- else -%}
            Search the lounge
          {%- endif -%}
        </h1>
      </div>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="facets">
      <input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search dresses, denim, silk...">
      <input type="hidden" name="type" value="product">
      <button class="button" type="submit">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        <div class="product-grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product_card_product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main search",
  "settings": [
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 36, "step": 4, "default": 16 }
  ]
}
{% endschema %}
