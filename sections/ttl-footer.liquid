{%- liquid
  assign whatsapp_href = settings.whatsapp_url
  if settings.whatsapp_number != blank
    assign clean_whatsapp_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
    assign whatsapp_href = 'https://wa.me/' | append: clean_whatsapp_number
  endif
-%}

<section class="footer-support" aria-label="Store support">
  <div class="page-width footer-support__grid">
    <div class="footer-support__item">
      <span class="footer-support__icon">{% render 'ttl-icon', icon: 'truck' %}</span>
      <span><strong>{{ section.settings.cod_heading }}</strong>{{ section.settings.cod_text }}</span>
    </div>
    <div class="footer-support__item">
      <span class="footer-support__icon">{% render 'ttl-icon', icon: 'clock' %}</span>
      <span><strong>{{ section.settings.returns_heading }}</strong>{{ section.settings.returns_text }}</span>
    </div>
    <div class="footer-support__item">
      <span class="footer-support__icon">{% render 'ttl-icon', icon: 'lock' %}</span>
      <span><strong>{{ section.settings.payment_heading }}</strong>{{ section.settings.payment_text }}</span>
    </div>
    <div class="footer-support__item">
      <span class="footer-support__icon">{% render 'ttl-icon', icon: 'headset' %}</span>
      <span><strong>{{ section.settings.support_heading }}</strong>{{ section.settings.support_text }}</span>
    </div>
  </div>
</section>

<div class="floating-contact" aria-label="Contact The Thrift Lounge">
  {%- if whatsapp_href != blank -%}
    <a class="floating-contact__item floating-contact__item--whatsapp" href="{{ whatsapp_href }}" aria-label="WhatsApp" title="WhatsApp">
      {% render 'ttl-icon', icon: 'whatsapp' %}
    </a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Compact footer",
  "settings": [
    {
      "type": "text",
      "id": "cod_heading",
      "label": "COD heading",
      "default": "COD Available"
    },
    {
      "type": "text",
      "id": "cod_text",
      "label": "COD text",
      "default": "Pay on delivery"
    },
    {
      "type": "text",
      "id": "returns_heading",
      "label": "Returns heading",
      "default": "7 Day Returns"
    },
    {
      "type": "text",
      "id": "returns_text",
      "label": "Returns text",
      "default": "Easy returns & exchanges"
    },
    {
      "type": "text",
      "id": "payment_heading",
      "label": "Payment heading",
      "default": "Secure Payment"
    },
    {
      "type": "text",
      "id": "payment_text",
      "label": "Payment text",
      "default": "100% safe & secure"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support heading",
      "default": "Customer Support"
    },
    {
      "type": "text",
      "id": "support_text",
      "label": "Support text",
      "default": "We're here to help"
    }
  ]
}
{% endschema %}
