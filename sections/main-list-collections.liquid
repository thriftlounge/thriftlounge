<section class="section">
  <div class="page-width">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Browse the lounge</p>
        <h1>Collections</h1>
      </div>
    </div>

    <div class="collection-grid">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a class="collection-card" href="{{ collection.url }}">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '300, 500, 700, 900', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-card__placeholder' }}
            {%- endif -%}
            <div class="collection-card__content">
              <p class="eyebrow">{{ collection.products_count }} pieces</p>
              <h3>{{ collection.title }}</h3>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main list collections"
}
{% endschema %}
