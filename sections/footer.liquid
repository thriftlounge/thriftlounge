<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <div>
      <h2>{{ section.settings.heading | default: shop.name }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="footer-social">
        {%- if settings.instagram_url != blank -%}
          <a href="{{ settings.instagram_url }}" aria-label="Instagram">{% render 'icon', icon: 'instagram' %} Instagram</a>
        {%- endif -%}
        {%- if settings.whatsapp_url != blank -%}
          <a href="{{ settings.whatsapp_url }}" aria-label="WhatsApp">{% render 'icon', icon: 'whatsapp' %} WhatsApp</a>
        {%- endif -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h3>{{ block.settings.heading }}</h3>
        {%- if block.settings.menu != blank -%}
          <nav class="footer-menu" aria-label="{{ block.settings.heading | escape }}">
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </nav>
        {%- endif -%}
      </div>
    {%- endfor -%}

    <div>
      <h3>Policies</h3>
      <nav class="footer-menu" aria-label="Policies">
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a href="{{ policy.url }}">{{ policy.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </div>

    <div>
      <h3>{{ section.settings.newsletter_heading }}</h3>
      {%- form 'customer' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input class="field" type="email" name="contact[email]" value="{{ form.email }}" autocorrect="off" autocapitalize="off" autocomplete="email" placeholder="Email address" required>
        <button class="button" type="submit">Join</button>
      {%- endform -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Thrift Lounge"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A warm boutique edit of women’s thrift, vintage, and pre-loved style."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join the lounge list"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu" },
      { "type": "menu" }
    ]
  }
}
{% endschema %}
