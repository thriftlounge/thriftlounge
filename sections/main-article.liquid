<article class="section">
  <div class="page-width rich-text__inner">
    <p class="eyebrow">{{ article.published_at | date: format: 'abbreviated_date' }}</p>
    <h1>{{ article.title }}</h1>

    {%- if article.image -%}
      <div class="product-gallery__item" style="margin: 28px 0;">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', sizes: '100vw', widths: '800, 1200, 1600', alt: article.image.alt }}
      </div>
    {%- endif -%}

    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{
  "name": "Main article"
}
{% endschema %}
