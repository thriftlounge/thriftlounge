{%- comment -%}
  Dynamic New Arrivals section. Merchants select the collection in theme settings
  or section settings; products are never hardcoded.
{%- endcomment -%}
{%- liquid
  assign featured_collection = settings.new_arrivals_collection | default: section.settings.collection
  assign products_to_show = section.settings.products_to_show
-%}

<section class="section ttl-pattern-jaali">
  <div class="page-width">
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <span class="ttl-paisley-divider" aria-hidden="true"></span>

    <div class="product-grid">
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- for product in featured_collection.products limit: products_to_show -%}
          {% render 'ttl-product-card', product_card_product: product, show_vendor: section.settings.show_vendor %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          {%- liquid
            assign fallback_image = 'ttl-product-palazzo.png'
            assign fallback_title = 'Crinkled Palazzo Set'
            assign fallback_price = '₹1,299'
            case i
              when 2
                assign fallback_image = 'ttl-product-lace-dress.png'
                assign fallback_title = 'Lace Wrap Dress'
                assign fallback_price = '₹1,199'
              when 3
                assign fallback_image = 'ttl-product-maxi-skirt.png'
                assign fallback_title = 'Flowy Maxi Skirt'
                assign fallback_price = '₹999'
              when 4
                assign fallback_image = 'ttl-product-boho-skirt.png'
                assign fallback_title = 'Boho Flared Skirt'
                assign fallback_price = '₹1,199'
              when 5
                assign fallback_image = 'ttl-product-jeans.png'
                assign fallback_title = 'Studded Flared Jeans'
                assign fallback_price = '₹1,399'
              when 6
                assign fallback_image = 'ttl-product-jacket.png'
                assign fallback_title = 'Embroidered Long Jacket'
                assign fallback_price = '₹1,299'
            endcase
          -%}
          <article class="product-card">
            <div class="product-card__media">
              <img src="{{ fallback_image | asset_url }}" alt="{{ fallback_title }}" loading="lazy">
              <span class="product-card__wishlist" aria-label="Wishlist">{% render 'ttl-icon', icon: 'heart' %}</span>
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">{{ fallback_title }}</h3>
              <span class="price">{{ fallback_price }}</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank and featured_collection != blank -%}
      <p style="margin-top: 30px;">
        <a class="button button--secondary" href="{{ featured_collection.url }}">{{ section.settings.button_label }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just landed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Select the New Arrivals collection to pull products dynamically from Shopify." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View the edit" }
  ],
  "presets": [
    { "name": "Featured collection" }
  ]
}
{% endschema %}
