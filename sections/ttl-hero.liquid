<section class="hero">
  <div class="hero__media">
    {%- assign hero_image = settings.hero_image | default: section.settings.image -%}
    {%- if hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '900, 1200, 1600, 2000, 2400',
          alt: hero_image.alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="page-width">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1>{{ settings.hero_heading | default: section.settings.heading | newline_to_br }}</h1>
      {%- assign hero_subheading = settings.hero_subheading | default: section.settings.text -%}
      {%- if hero_subheading != blank -%}
        <p>{{ hero_subheading }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- assign hero_button_text = settings.hero_button_text | default: section.settings.primary_label -%}
        {%- assign hero_button_link = settings.hero_button_link | default: section.settings.primary_link -%}
        {%- if hero_button_text != blank -%}
          <a class="button" href="{{ hero_button_link }}">{{ hero_button_text }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated thrift boutique" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "TIMELESS PIECES,\nYOUR STORY." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Handpicked styles that blend comfort, charm & effortless elegance." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop New Drops" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button" },
    { "type": "url", "id": "secondary_link", "label": "Secondary link" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
