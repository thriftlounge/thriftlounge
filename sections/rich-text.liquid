<section class="section rich-text">
  <div class="page-width rich-text__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <div>{{ section.settings.text }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The lounge note" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Secondhand style, selected with care." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use this editable section for store philosophy, sizing notes, sustainable shopping, or boutique service details.</p>" }
  ],
  "presets": [
    { "name": "Rich text" }
  ]
}
{% endschema %}
