<section class="trust-bar section--compact">
  <div class="page-width trust-bar__grid">
    {%- for block in section.blocks -%}
      <div class="trust-bar__item" {{ block.shopify_attributes }}>
        <span class="trust-bar__icon">
          {% render 'icon', icon: block.settings.icon %}
        </span>
        <span>{{ block.settings.title }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Curated" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "quality", "label": "Quality" },
            { "value": "bag", "label": "Shopping" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Curated Styles" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "sparkle", "title": "Curated Styles" } },
        { "type": "trust_item", "settings": { "icon": "leaf", "title": "Sustainable Fashion" } },
        { "type": "trust_item", "settings": { "icon": "quality", "title": "Quality Pieces" } },
        { "type": "trust_item", "settings": { "icon": "bag", "title": "Easy Shopping" } }
      ]
    }
  ]
}
{% endschema %}
