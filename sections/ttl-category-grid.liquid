{%- comment -%}
  Category grid. Uses global category collection selectors first, then editable
  section blocks as a fallback for Shopify customizer flexibility.
{%- endcomment -%}
<section class="section ttl-pattern-paisley">
  <div class="page-width">
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <span class="ttl-paisley-divider" aria-hidden="true"></span>

    <div class="collection-grid">
      {%- liquid
        assign has_theme_categories = false
        if settings.category_collection_1 != blank or settings.category_collection_2 != blank or settings.category_collection_3 != blank or settings.category_collection_4 != blank or settings.category_collection_5 != blank or settings.category_collection_6 != blank
          assign has_theme_categories = true
        endif
      -%}

      {%- if has_theme_categories -%}
        {%- assign collection = settings.category_collection_1 -%}
        {%- if collection != blank -%}{% render 'ttl-collection-card', collection: collection, fallback_image: 'ttl-category-dresses.png' %}{%- endif -%}
        {%- assign collection = settings.category_collection_2 -%}
        {%- if collection != blank -%}{% render 'ttl-collection-card', collection: collection, fallback_image: 'ttl-category-tops.png' %}{%- endif -%}
        {%- assign collection = settings.category_collection_3 -%}
        {%- if collection != blank -%}{% render 'ttl-collection-card', collection: collection, fallback_image: 'ttl-category-bottoms.png' %}{%- endif -%}
        {%- assign collection = settings.category_collection_4 -%}
        {%- if collection != blank -%}{% render 'ttl-collection-card', collection: collection, fallback_image: 'ttl-category-coords.png' %}{%- endif -%}
        {%- assign collection = settings.category_collection_5 -%}
        {%- if collection != blank -%}{% render 'ttl-collection-card', collection: collection, fallback_image: 'ttl-category-ethnic.png' %}{%- endif -%}
        {%- assign collection = settings.category_collection_6 -%}
        {%- if collection != blank -%}{% render 'ttl-collection-card', collection: collection, fallback_image: 'ttl-category-sale.png' %}{%- endif -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          {%- liquid
            assign fallback_image = 'ttl-category-dresses.png'
            case forloop.index
              when 2
                assign fallback_image = 'ttl-category-tops.png'
              when 3
                assign fallback_image = 'ttl-category-bottoms.png'
              when 4
                assign fallback_image = 'ttl-category-coords.png'
              when 5
                assign fallback_image = 'ttl-category-ethnic.png'
              when 6
                assign fallback_image = 'ttl-category-sale.png'
            endcase
          -%}
          {% render 'ttl-collection-card', collection: collection, fallback_title: block.settings.fallback_title, fallback_image: fallback_image, block: block %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated corners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Choose collections in the theme customizer to build category cards." }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "fallback_title", "label": "Fallback title", "default": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" },
        { "type": "featured_collection" }
      ]
    }
  ]
}
{% endschema %}
